# ============================================================
# LLM Provider — 内部 OpenAI-compatible 多模型网关
# ============================================================
JD_LLM_API_KEY=your_key_here
JD_LLM_BASE_URL=https://your-internal-gateway.example.com/v1
XIAOSHU_MODEL=DeepSeek-V4-Pro
# Gemini-3 reasoning depth for the main chat: high (max, default) | medium | low
# XIAOSHU_THINKING_LEVEL=high
# Max answer tokens (gateway hard ceiling for this model is 65536 = default)
# XIAOSHU_MAX_OUTPUT_TOKENS=65536

# ============================================================
# Magnus Lens 运行配置（可选，均有默认值）
# ============================================================
# 存储：生产/本地并发用 Postgres（`docker compose up -d db` 后即为下面这行）。
# 注释掉则回退 sqlite（仅单进程/测试，不支持并发 worker）。
MAGNUS_LENS_DB_URL=postgresql+psycopg://lens:lens@127.0.0.1:5433/magnus_lens
# MAGNUS_LENS_REPOS_ROOT=../repos                 # 本地 clone 根目录
# MAGNUS_LENS_SKILLS_ROOT=../skills-repo            # skill 同步目标仓库
# MAGNUS_LENS_POLL_INTERVAL_SECONDS=600           # 轮询周期（前端倒计时据此计算）
# MAGNUS_LENS_ENABLE_ANALYSIS_LAYER=true          # Phase 2 分析层（事实层之上的主观推断）
# MAGNUS_LENS_ENABLE_CORRELATION=true             # Phase 3 跨库关联子图
# MAGNUS_LENS_ADVERSARIAL_VERIFY=true             # 高价值 tier 的对抗验证
